generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  name                     String
  email                    String    @unique
  password                 String    @default("")
  customerId               String    @unique
  role                     String    @default("client") // client | admin | it_support
  backupPlan               Boolean   @default(false) // $25/mo Backup plan, set by admin/IT after offline billing: enables uploads, downloads and Backup folders
  isActive                 Boolean   @default(true) // false = deactivated by IT support/admin, login blocked
  emailVerified            DateTime? // null until verified; OAuth sign-ins are auto-verified
  verifyEmailToken         String?   // sha256 hash of the current verification token
  verifyEmailTokenExpires  DateTime?
  verifyEmailIssuedAt      DateTime? // for resend throttling
  mfaCode         String?   // sha256 hash of the current login OTP
  mfaCodeExpires  DateTime?
  mfaCodeIssuedAt DateTime?
  mfaAttempts     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tickets         Ticket[]
  resetTokens     PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 hash of the raw token sent by email
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Ticket {
  id         String   @id @default(cuid())
  ticketNo   String   @unique // GDC-TKT-XXXXXX
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  category   String   // tax | immigration | company | technical | general
  priority   String   @default("medium") // low | medium | high | urgent
  status     String   @default("open")   // open | in_progress | resolved | closed
  message    String
  response   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AppSetting {
  key   String @id // e.g. "backupRoot"
  value String
}

// Point-in-time copy of a customer's Dropbox listing. Free-plan clients only ever see
// this snapshot (refreshed at most every 24h); it also feeds the staff Backup Status tab.
model SyncSnapshot {
  id           String    @id @default(cuid())
  customerId   String
  area         String    // documents | backup
  data         String    // JSON: { files, folders }
  fileCount    Int       @default(0)
  folderCount  Int       @default(0)
  totalSize    Float     @default(0)
  lastModified DateTime? // newest file change seen in Dropbox
  syncedAt     DateTime  @default(now())

  @@unique([customerId, area])
}
