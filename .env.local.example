# ─── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development (file-based, no setup needed)
DATABASE_URL="file:./dev.db"

# ─── Sign in with Microsoft (Outlook / Office 365) ─────────────────────────────
# Optional — the "Continue with Microsoft" button only appears when these are set.
# 1. Go to https://portal.azure.com → Microsoft Entra ID → App registrations → New registration
#    - Supported account types: "Accounts in any organizational directory and personal
#      Microsoft accounts" (this is what lets both Outlook.com and work/school accounts sign in)
#    - Redirect URI (Web): http://localhost:3000/api/auth/callback/azure-ad
#      In production, use https://yourdomain.com/api/auth/callback/azure-ad
# 2. Copy the "Application (client) ID" below
# 3. Certificates & secrets → New client secret → copy the VALUE (not the ID) below
AZURE_AD_CLIENT_ID=your-azure-app-client-id
AZURE_AD_CLIENT_SECRET=your-azure-app-client-secret
# "common" (default) accepts both personal and work/school accounts — usually leave unset
# AZURE_AD_TENANT_ID=common

# ─── Email — Microsoft Graph API (sends as SMTP_USER below) ────────────────────
# Replaces SMTP entirely — no SMTP AUTH required, works even when your tenant
# has "SmtpClientAuthentication" disabled (the modern default for Microsoft 365).
# Reuses the SAME app registration as "Sign in with Microsoft" above.
# Setup: https://portal.azure.com → your app → API permissions → Add a permission
#   → Microsoft Graph → Application permissions → Mail.Send → Add
#   → then click "Grant admin consent" (requires a Global/Exchange admin).
# AZURE_MAIL_TENANT_ID must be the REAL tenant ID (a GUID, or your
# *.onmicrosoft.com domain) — unlike AZURE_AD_TENANT_ID above, "common" does
# NOT work here; client-credentials tokens are always scoped to one tenant.
# Find it at: Entra ID → Overview → Tenant ID
AZURE_MAIL_TENANT_ID=your-real-tenant-id-or-onmicrosoft-domain

# ─── Dropbox Integration ───────────────────────────────────────────────────────
# RECOMMENDED (production — never expires):
# Step 1: Create app at https://www.dropbox.com/developers/apps
#         Permissions: files.content.read + files.content.write + files.metadata.read
#         Add redirect URI: http://localhost:3001/callback
# Step 2: Run: DROPBOX_APP_KEY=xxx DROPBOX_APP_SECRET=yyy node scripts/getDropboxToken.cjs
# Step 3: Copy the printed values below
DROPBOX_APP_KEY=your-app-key
DROPBOX_APP_SECRET=your-app-secret
DROPBOX_REFRESH_TOKEN=your-refresh-token

# TESTING ONLY (short-lived, expires in ~4 hours):
# Get from: https://www.dropbox.com/developers/apps → your app → Generated access token
# DROPBOX_ACCESS_TOKEN=your-short-lived-token

# SMTP_USER is the mailbox Graph sends as (kept from the old SMTP setup).
# SMTP_HOST/PORT/PASS/FROM are no longer used — mail now goes through Graph.
SMTP_USER=priti@goldendollarconsulting.com
SUPPORT_EMAIL=itsupport@goldendollarconsulting.com

# ─── Seed Passwords (used only when running: npm run db:seed) ──────────────────
ADMIN_SEED_PASSWORD=GDC@Admin2025!
IT_SEED_PASSWORD=GDC@ITSupport2025!
